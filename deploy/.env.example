# Copy to deploy/.env and replace placeholders locally. Never commit deploy/.env.
WEBJJONKU_COORDINATOR_TOKEN=replace-with-random-admin-token
WEBJJONKU_CONNECTOR_TOKEN=replace-with-scoped-connector-token
WEBJJONKU_BROWSER_NAS_TOKEN=replace-with-scoped-browser-token
WEBJJONKU_BIND_IP=127.0.0.1
WEBJJONKU_DATA_DIR=./runtime
WEBJJONKU_NAS_WORKSPACE=..
WEBJJONKU_FILE_ROOT=./runtime/files
WEBJJONKU_TAILSCALE_HOSTNAME=chatgpt-connector
MONITOR_NFS_HOST=
